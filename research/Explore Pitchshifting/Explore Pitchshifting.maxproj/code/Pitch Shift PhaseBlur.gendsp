            {
                "box": {
                    "fontname": "Lato",
                    "fontsize": 12.0,
                    "id": "obj-60",
                    "linecount": 3,
                    "maxclass": "comment",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 56.333328, 313.0, 123.0, 50.0 ],
                    "text": "delta → sah: Erklärung 04–06 und 09 rechts."
                }
            },
            {
                "box": {
                    "annotation": "02 — noise UND abs — noise erzeugt bei jedem Sample einen neuen Zufallswert ungefähr zwischen −1 und +1. abs bildet den Betrag: −0.7 wird +0.7, +0.3 bleibt +0.3. So wird daraus ein nichtnegativer Zufallswert von 0 bis ungefähr 1. abs glättet nichts und speichert nichts.",
                    "fontname": "Lato",
                    "fontsize": 12.0,
                    "id": "obj-56",
                    "maxclass": "newobj",
                    "numinlets": 1,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 688.0, 138.0, 30.0, 23.0 ],
                    "text": "abs"
                }
            },
            {
                "box": {
                    "annotation": "02 — noise UND abs — noise erzeugt bei jedem Sample einen neuen Zufallswert ungefähr zwischen −1 und +1. abs bildet den Betrag: −0.7 wird +0.7, +0.3 bleibt +0.3. So wird daraus ein nichtnegativer Zufallswert von 0 bis ungefähr 1. abs glättet nichts und speichert nichts.",
                    "fontname": "Lato",
